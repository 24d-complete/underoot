+		if ((this.config.explorer as any).hideFileExtensions && !stat.isDirectory) {
+			if (typeof label === 'string') {
+				const dotIndex = label.lastIndexOf('.');
+				if (dotIndex > 0) {
+					label = label.substring(0, dotIndex);
+				}
+			} else if (Array.isArray(label) && label.length > 0) {
+				const lastLabel = label[label.length - 1];
+				const dotIndex = lastLabel.lastIndexOf('.');
+				if (dotIndex > 0) {
+					label[label.length - 1] = lastLabel.substring(0, dotIndex);
+				}
+			}
+		}
+
+		templateData.label.element.style.display = 'flex';

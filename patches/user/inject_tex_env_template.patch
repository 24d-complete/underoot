+/**
+ * Underoot: Inject TeX Environment Variables
+ * Takes the locally managed distribution and injects it into the PATH
+ * just for this extension host process.
+ */
+function injectTexEnvironment() {
+	try {
+		const homeDir = os.homedir();
+		const platform = process.platform;
+		let texBinPath = '';
+
+		if (platform === 'win32') {
+			texBinPath = path.join(homeDir, '.underoot', 'tools', 'texlive', 'bin', 'windows');
+		} else {
+			// Fallback/Linux logic (to be refined)
+			texBinPath = path.join(homeDir, '.underoot', 'tools', 'texlive', 'bin', 'x86_64-linux');
+		}
+
+		if (fs.existsSync(texBinPath)) {
+			process.env['PATH'] = texBinPath + path.delimiter + process.env['PATH'];
+			console.log(`[Underoot] Injected TeX environment: ${texBinPath}`);
+		}
+	} catch (e) {
+		console.error('[Underoot] Failed to inject TeX environment', e);
+	}
+}

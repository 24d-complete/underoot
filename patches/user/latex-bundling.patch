+	private async injectTeXPath(): Promise<void> {
+		try {
+			const home = homedir();
+			const configPath = resolve(join(home, '.underoot', 'config.json'));
+			let texBinPath: string | undefined;
+
+			try {
+				const content = await promises.readFile(configPath, 'utf8');
+				const config = JSON.parse(content);
+				if (config.texPath && typeof config.texPath === 'string') {
+					texBinPath = config.texPath;
+				}
+			} catch (error) {
+				// ignore
+			}
+
+			// Default to TeX Live installation path with platform-specific bin directory
+			if (!texBinPath) {
+				const base = join(home, '.underoot', 'tools', 'texlive', 'bin');
+				if (isMacintosh) texBinPath = join(base, 'universal-darwin');
+				else if (isLinux) texBinPath = join(base, 'x86_64-linux');
+				else if (isWindows) texBinPath = join(base, 'windows');
+			}
+
+			if (texBinPath) {
+				const pathKey = isWindows ? 'Path' : 'PATH';
+				const currentPath = process.env[pathKey] || '';
+				// Always inject, so it works even if installed later in the session
+				process.env[pathKey] = texBinPath + (isWindows ? ';' : ':') + currentPath;
+				console.log(`[Underoot] Injected TeX Live path: ${texBinPath}`);
+			}
+		} catch (error) {
+			console.error('[Underoot] Failed to inject TeX Live path', error);
+		}
+	}
 }
 

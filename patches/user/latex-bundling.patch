+import { Emitter, Event } from '../../../base/common/event.js';
+import { IDistributionService } from '../common/distribution.js';
+import { ILogService } from '../../log/common/log.js';
+import { IEnvironmentService } from '../../environment/common/environment.js';
+import * as path from '../../../base/common/path.js';
+import * as os from 'os';
+import * as fs from 'fs';
+import * as https from 'https';
+import * as child_process from 'child_process';
+import { isWindows, isMacintosh, isLinux } from '../../../base/common/platform.js';
+import { IServerChannel } from '../../../base/parts/ipc/common/ipc.js';
+
+export class DistributionService implements IDistributionService {
+    declare readonly _serviceBrand: undefined;
+
+    private readonly _onDidChangeDistribution = new Emitter<void>();
+    readonly onDidChangeDistribution = this._onDidChangeDistribution.event;
+
+    private readonly _onInstallProgress = new Emitter<{ steps: number; total: number; message: string }>();
+    readonly onInstallProgress = this._onInstallProgress.event;
+
+    constructor(
+        @ILogService private readonly logService: ILogService,
+        @IEnvironmentService private readonly environmentService: IEnvironmentService
+    ) { }
+
+    private getTexLiveBinPath(): string {
+        const home = os.homedir();
+        const base = path.join(home, '.underoot', 'tools', 'texlive', 'bin');
+        if (isMacintosh) return path.join(base, 'universal-darwin');
+        else if (isLinux) return path.join(base, 'x86_64-linux');
+        else return path.join(base, 'windows');
+    }
+
+    async checkDistro(): Promise<string | undefined> {
+        const binPath = this.getTexLiveBinPath();
+        const texliveonfly = path.join(binPath, isWindows ? 'texliveonfly.exe' : 'texliveonfly');
+
+        if (fs.existsSync(texliveonfly)) {
+            this._updatePath(binPath);
+            return binPath;
+        }
+
+        // Check for bundled TeX Live in application resources
+        if (this.environmentService.isBuilt) {
+            const bundledPath = path.join(path.dirname(this.environmentService.appRoot), 'texlive');
+            const bundledBinPath = this.getPlatformBinPath(bundledPath);
+            const bundledTexliveonfly = path.join(bundledBinPath, isWindows ? 'texliveonfly.exe' : 'texliveonfly');
+
+            if (fs.existsSync(bundledTexliveonfly)) {
+                this.logService.info('Found bundled TeX Live. Initializing user installation...');
+                const installPath = path.join(os.homedir(), '.underoot', 'tools', 'texlive');
+
+                try {
+                    // Copy bundled version to user directory
+                    // We use cp -r equivalent. 
+                    await fs.promises.cp(bundledPath, installPath, { recursive: true });
+
+                    this.logService.info('Initialization complete using bundled TeX Live.');
+                    this._updatePath(binPath); // binPath is the standard user path, which we just filled
+                    return binPath;
+                } catch (err) {
+                    this.logService.error('Failed to initialize bundled TeX Live:', err);
+                }
+            }
+        }
+
+        return undefined;
+    }
+
+    private getPlatformBinPath(root: string): string {
+        const base = path.join(root, 'bin');
+        if (isMacintosh) return path.join(base, 'universal-darwin');
+        else if (isLinux) return path.join(base, 'x86_64-linux');
+        else return path.join(base, 'windows');
+    }
+
+    async install(): Promise<void> {
+        this.logService.info('Starting TeX Live installation...');
+        const home = os.homedir();
+        const installPath = path.join(home, '.underoot', 'tools', 'texlive');
+
+        this._onInstallProgress.fire({ steps: 5, total: 100, message: 'Downloading TeX Live installer...' });
+
+        try {
+            // Download and run the tex-installer script
+            const tempDir = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'texlive-'));
+            const installerUrl = isWindows
+                ? 'https://mirror.ctan.org/systems/texlive/tlnet/install-tl-windows.exe'
+                : 'https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz';
+
+            this._onInstallProgress.fire({ steps: 10, total: 100, message: 'Downloading...' });
+
+            const archivePath = path.join(tempDir, isWindows ? 'install-tl.exe' : 'install-tl.tar.gz');
+            await this.downloadFile(installerUrl, archivePath);
+
+            this._onInstallProgress.fire({ steps: 30, total: 100, message: 'Extracting installer...' });
+
+            let installerPath: string;
+            if (isWindows) {
+                installerPath = archivePath;
+            } else {
+                // Extract tarball
+                await new Promise<void>((resolve, reject) => {
+                    const tar = child_process.spawn('tar', ['-xzf', archivePath, '-C', tempDir]);
+                    tar.on('close', (code) => {
+                        if (code === 0) resolve();
+                        else reject(new Error(`tar failed with code ${code}`));
+                    });
+                });
+
+                // Find extracted directory
+                const dirs = fs.readdirSync(tempDir).filter(f =>
+                    f.startsWith('install-tl') && fs.statSync(path.join(tempDir, f)).isDirectory()
+                );
+                installerPath = path.join(tempDir, dirs[0], 'install-tl');
+            }
+
+            this._onInstallProgress.fire({ steps: 40, total: 100, message: 'Creating profile...' });
+
+            // Create profile
+            const profilePath = path.join(tempDir, 'texlive.profile');
+            const texDir = installPath.split(path.sep).join('/');
+            const profile = `
+selected_scheme scheme-basic
+TEXDIR ${texDir}
+TEXMFLOCAL ${texDir}/texmf-local
+TEXMFSYSCONFIG ${texDir}/texmf-config
+TEXMFSYSVAR ${texDir}/texmf-var
+collection-basic 1
+collection-latex 1
+instopt_adjustpath 0
+instopt_adjustrepo 1
+instopt_letter 0
+instopt_portable 1
+instopt_write18_restricted 1
+tlpdbopt_install_docfiles 0
+tlpdbopt_install_srcfiles 0
+`.trim();
+            await fs.promises.writeFile(profilePath, profile);
+
+            this._onInstallProgress.fire({ steps: 50, total: 100, message: 'Installing TeX Live (this may take a few minutes)...' });
+
+            // Run installer
+            await new Promise<void>((resolve, reject) => {
+                this.logService.info(`Running installer: ${installerPath} -profile ${profilePath}`);
+                const child = child_process.spawn(installerPath, ['-profile', profilePath], {
+                    cwd: path.dirname(installerPath)
+                });
+
+                child.stdout.on('data', d => this.logService.info(`[install-tl] ${d.toString().trim()}`));
+                child.stderr.on('data', d => this.logService.error(`[install-tl] ${d.toString().trim()}`));
+
+                child.on('close', (code) => {
+                    if (code === 0) resolve();
+                    else reject(new Error(`Installer failed with code ${code}`));
+                });
+                child.on('error', reject);
+            });
+
+            this._onInstallProgress.fire({ steps: 80, total: 100, message: 'Installing texliveonfly...' });
+
+            // Install texliveonfly
+            const binPath = this.getTexLiveBinPath();
+            const tlmgr = path.join(binPath, isWindows ? 'tlmgr.bat' : 'tlmgr');
+
+            await this.runTlmgr(tlmgr, ['install', 'texliveonfly']);
+            await this.runTlmgr(tlmgr, ['install', 'latexmk']);
+            await this.runTlmgr(tlmgr, ['install', 'collection-fontsrecommended']);
+            await this.runTlmgr(tlmgr, ['install', 'collection-latexrecommended']);
+
+            this._onInstallProgress.fire({ steps: 100, total: 100, message: 'Installation complete!' });
+
+            // Cleanup
+            await fs.promises.rm(tempDir, { recursive: true, force: true });
+
+            this._updatePath(binPath);
+            this.logService.info('TeX Live with texliveonfly installed successfully.');
+            this._onDidChangeDistribution.fire();
+        } catch (error) {
+            this.logService.error('TeX Live installation failed:', error);
+            throw error;
+        }
+    }
+
+    private runTlmgr(tlmgr: string, args: string[]): Promise<void> {
+        return new Promise((resolve, reject) => {
+            this.logService.info(`运行 tlmgr: ${tlmgr} ${args.join(' ')}`);
+            const child = child_process.spawn(tlmgr, args);
+
+            child.stdout.on('data', d => this.logService.info(`[tlmgr] ${d.toString().trim()}`));
+            child.stderr.on('data', d => this.logService.error(`[tlmgr] ${d.toString().trim()}`));
+
+            child.on('close', (code) => {
+                if (code === 0) resolve();
+                else reject(new Error(`tlmgr ${args.join(' ')} failed with code ${code}`));
+            });
+            child.on('error', reject);
+        });
+    }
+
+    private downloadFile(url: string, destPath: string): Promise<void> {
+        return new Promise((resolve, reject) => {
+            const file = fs.createWriteStream(destPath);
+
+            const request = (urlStr: string) => {
+                https.get(urlStr, (response) => {
+                    // Handle all redirect codes (301, 302, 307, 308)
+                    if (response.statusCode && response.statusCode >= 300 && response.statusCode < 400) {
+                        const redirectUrl = response.headers.location;
+                        if (redirectUrl) {
+                            request(redirectUrl);
+                            return;
+                        }
+                    }
+
+                    if (response.statusCode !== 200) {
+                        reject(new Error(`Failed to download: HTTP ${response.statusCode}`));
+                        return;
+                    }
+
+                    response.pipe(file);
+                    file.on('finish', () => {
+                        file.close();
+                        resolve();
+                    });
+                }).on('error', (err) => {
+                    fs.unlink(destPath, () => { });
+                    reject(err);
+                });
+            };
+
+            request(url);
+        });
+    }
+
+    async uninstall(): Promise<void> {
+        this.logService.info('Uninstalling TeX Live...');
+        const home = os.homedir();
+        const installPath = path.join(home, '.underoot', 'tools', 'texlive');
+
+        try {
+            await fs.promises.rm(installPath, { recursive: true, force: true });
+            this.logService.info('Uninstalled successfully.');
+            this._updatePath(undefined);
+            this._onDidChangeDistribution.fire();
+        } catch (error) {
+            this.logService.error('Uninstall failed:', error);
+            throw error;
+        }
+    }
+
+    async installPackage(packageName: string): Promise<void> {
+        this.logService.info(`Installing package: ${packageName}`);
+        const binPath = this.getTexLiveBinPath();
+        const tlmgr = path.join(binPath, isWindows ? 'tlmgr.bat' : 'tlmgr');
+        await this.runTlmgr(tlmgr, ['install', packageName]);
+    }
+
+    async findPackageForFile(fileName: string): Promise<string | undefined> {
+        const binPath = this.getTexLiveBinPath();
+        const tlmgr = path.join(binPath, isWindows ? 'tlmgr.bat' : 'tlmgr');
+
+        return new Promise((resolve) => {
+            const child = child_process.spawn(tlmgr, ['search', '--file', fileName]);
+            let output = '';
+            child.stdout?.on('data', (data) => { output += data.toString(); });
+            child.on('close', () => {
+                const match = output.match(/^(\S+):$/m);
+                resolve(match ? match[1] : undefined);
+            });
+            child.on('error', () => resolve(undefined));
+        });
+    }
+
+    private _updatePath(binDir: string | undefined): void {
+        if (binDir) {
+            if (!process.env.PATH?.includes(binDir)) {
+                process.env.PATH = `${binDir}${path.delimiter}${process.env.PATH}`;
+            }
+        }
+    }
+}
+
+export class DistributionChannel implements IServerChannel {
+    constructor(private service: IDistributionService) { }
+
+    listen<T>(_ctx: string, event: string): Event<T> {
+        switch (event) {
+            case 'onDidChangeDistribution': return this.service.onDidChangeDistribution as Event<T>;
+            case 'onInstallProgress': return this.service.onInstallProgress as Event<T>;
+        }
+        throw new Error(`Event not found: ${event}`);
+    }
+
+    call<T>(_ctx: string, command: string, arg?: any): Promise<T> {
+        switch (command) {
+            case 'checkDistro': return this.service.checkDistro() as Promise<T>;
+            case 'install': return this.service.install() as Promise<T>;
+            case 'uninstall': return this.service.uninstall() as Promise<T>;
+            case 'installPackage': return this.service.installPackage(arg as string) as Promise<T>;
+            case 'findPackageForFile': return this.service.findPackageForFile(arg as string) as Promise<T>;
+        }
+        throw new Error(`Command not found: ${command}`);
+    }
+}

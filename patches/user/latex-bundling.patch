+import * as fs from 'fs';
+import * as path from 'path';
+import * as os from 'os';
+import * as https from 'https';
+import * as child_process from 'child_process';
+import * as zlib from 'zlib';
+
+/**
+ * TeX Live Installer Script
+ * 
+ * Usage: node tex-installer.js [install-path] [scheme]
+ * Default install-path: ~/.underoot/tools/texlive
+ * Default scheme: scheme-basic
+ */
+
+const IS_WINDOWS = process.platform === 'win32';
+const INSTALL_TL_URL_WIN = 'https://mirror.ctan.org/systems/texlive/tlnet/install-tl-windows.exe';
+const INSTALL_TL_URL_UNIX = 'https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz';
+
+async function main() {
+    const installPath = process.argv[2] || path.join(os.homedir(), '.underoot', 'tools', 'texlive');
+    const scheme = process.argv[3] || 'scheme-basic';
+
+    console.log(`[TeX Installer] Starting installation...`);
+    console.log(`[TeX Installer] Target: ${installPath}`);
+    console.log(`[TeX Installer] Scheme: ${scheme}`);
+
+    // Ensure install directory exists (or parent)
+    if (!fs.existsSync(installPath)) {
+        fs.mkdirSync(installPath, { recursive: true });
+    }
+
+    const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'texlive-'));
+    console.log(`[TeX Installer] Working in: ${tempDir}`);
+
+    try {
+        // 1. Download Installer
+        const installerPath = await downloadInstaller(tempDir);
+
+        // 2. Generate Profile
+        const profilePath = path.join(tempDir, 'texlive.profile');
+        createProfile(profilePath, installPath, scheme);
+
+        // 3. Run Installer
+        await runInstaller(installerPath, profilePath, tempDir);
+
+        // 4. Install texliveonfly for automatic package installation
+        console.log(`[TeX Installer] Installing texliveonfly...`);
+        await installPackage(installPath, 'texliveonfly');
+        await installPackage(installPath, 'latexmk');
+        await installPackage(installPath, 'collection-fontsrecommended');
+        await installPackage(installPath, 'collection-latexrecommended');
+
+        console.log(`[TeX Installer] Installation complete!`);
+    } catch (e) {
+        console.error(`[TeX Installer] Installation failed:`, e);
+        process.exit(1);
+    } finally {
+        // Cleanup
+        try {
+            // fs.rmSync(tempDir, { recursive: true, force: true });
+            console.log(`[TeX Installer] Cleanup skipped for debugging: ${tempDir}`);
+        } catch (e) { }
+    }
+}
+
+async function downloadInstaller(workDir: string): Promise<string> {
+    const url = IS_WINDOWS ? INSTALL_TL_URL_WIN : INSTALL_TL_URL_UNIX;
+    const destName = IS_WINDOWS ? 'install-tl.exe' : 'install-tl.tar.gz';
+    const destPath = path.join(workDir, destName);
+
+    console.log(`[TeX Installer] Downloading ${url}...`);
+
+    return new Promise((resolve, reject) => {
+        const file = fs.createWriteStream(destPath);
+        https.get(url, (response) => {
+            if (response.statusCode !== 200) {
+                return reject(new Error(`Failed to download: Status ${response.statusCode}`));
+            }
+
+            response.pipe(file);
+            file.on('finish', () => {
+                file.close();
+                console.log(`[TeX Installer] Download finished.`);
+
+                if (IS_WINDOWS) {
+                    resolve(destPath);
+                } else {
+                    // Extract tarball
+                    extractTarball(destPath, workDir).then(resolve).catch(reject);
+                }
+            });
+        }).on('error', (err) => {
+            fs.unlink(destPath, () => { });
+            reject(err);
+        });
+    });
+}
+
+function extractTarball(tarPath: string, workDir: string): Promise<string> {
+    console.log(`[TeX Installer] Extracting...`);
+    return new Promise((resolve, reject) => {
+        // Native tar command is usually available on macOS/Linux
+        const tar = child_process.spawn('tar', ['-xzf', tarPath, '-C', workDir]);
+
+        tar.on('close', (code) => {
+            if (code === 0) {
+                // Find the extracted folder
+                const dirs = fs.readdirSync(workDir).filter(f => f.startsWith('install-tl') && fs.statSync(path.join(workDir, f)).isDirectory());
+                if (dirs.length > 0) {
+                    resolve(path.join(workDir, dirs[0], 'install-tl'));
+                } else {
+                    reject(new Error('Could not find extracted install-tl directory'));
+                }
+            } else {
+                reject(new Error(`tar exited with code ${code}`));
+            }
+        });
+    });
+}
+
+function createProfile(profilePath: string, installPath: string, scheme: string) {
+    console.log(`[TeX Installer] Creating profile: ${profilePath}`);
+
+    // Convert path to slashes for TeX Live
+    const texDir = installPath.split(path.sep).join('/');
+
+    const content = `
+selected_scheme ${scheme}
+TEXDIR ${texDir}
+TEXMFLOCAL ${texDir}/texmf-local
+TEXMFSYSCONFIG ${texDir}/texmf-config
+TEXMFSYSVAR ${texDir}/texmf-var
+collection-basic 1
+collection-latex 1
+instopt_adjustpath 0
+instopt_adjustrepo 1
+instopt_letter 0
+instopt_portable 1
+instopt_write18_restricted 1
+tlpdbopt_autobackup 1
+tlpdbopt_backupdir tlpkg/backups
+tlpdbopt_create_formats 1
+tlpdbopt_desktop_integration 0
+tlpdbopt_file_assocs 0
+tlpdbopt_generate_updmap 0
+tlpdbopt_install_docfiles 0
+tlpdbopt_install_srcfiles 0
+tlpdbopt_post_code 1
+tlpdbopt_sys_bin /usr/local/bin
+tlpdbopt_sys_info /usr/local/share/info
+tlpdbopt_sys_man /usr/local/share/man
+tlpdbopt_w32_multi_user 0
+`.trim();
+
+    fs.writeFileSync(profilePath, content);
+}
+
+async function runInstaller(installerPath: string, profilePath: string, workDir: string): Promise<void> {
+    console.log(`[TeX Installer] Running installer...`);
+    console.log(`[Debug] Installer: ${installerPath}`);
+    console.log(`[Debug] Profile: ${profilePath}`);
+
+    const args = ['-profile', profilePath];
+
+    // On Unix, installerPath is the script
+    const cmd = installerPath;
+
+    return new Promise((resolve, reject) => {
+        const child = child_process.spawn(cmd, args, {
+            cwd: path.dirname(installerPath),
+            stdio: 'inherit'
+        });
+
+        child.on('close', (code) => {
+            if (code === 0) {
+                resolve();
+            } else {
+                reject(new Error(`Installer exited with code ${code}`));
+            }
+        });
+
+        child.on('error', (err) => {
+            reject(err);
+        });
+    });
+}
+
+async function installPackage(installPath: string, packageName: string): Promise<void> {
+    console.log(`[TeX Installer] Installing package: ${packageName}`);
+
+    // Find tlmgr binary
+    const binDir = IS_WINDOWS
+        ? path.join(installPath, 'bin', 'windows')
+        : process.platform === 'darwin'
+            ? path.join(installPath, 'bin', 'universal-darwin')
+            : path.join(installPath, 'bin', 'x86_64-linux');
+
+    const tlmgr = path.join(binDir, IS_WINDOWS ? 'tlmgr.bat' : 'tlmgr');
+
+    return new Promise((resolve, reject) => {
+        const child = child_process.spawn(tlmgr, ['install', packageName], {
+            stdio: 'inherit'
+        });
+
+        child.on('close', (code) => {
+            if (code === 0) {
+                console.log(`[TeX Installer] Installed ${packageName}`);
+                resolve();
+            } else {
+                reject(new Error(`Failed to install ${packageName}: exit code ${code}`));
+            }
+        });
+
+        child.on('error', (err) => {
+            reject(err);
+        });
+    });
+}
+
+
+import { fileURLToPath } from 'url';
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+    main().catch(console.error);
+}
+

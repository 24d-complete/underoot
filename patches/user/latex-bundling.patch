+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IDistributionService } from '../../../../platform/distribution/common/distribution.js';
+import { DISRIBUTION_IPC_CHANNEL_NAME } from '../../../../platform/distribution/common/distributionIpc.js';
+import { registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { IRemoteAgentService } from '../../remote/common/remoteAgentService.js';
+
+import { ProxyChannel } from '../../../../base/parts/ipc/common/ipc.js';
+import { INotificationService, Severity } from '../../../../platform/notification/common/notification.js';
+import { IProgressService, ProgressLocation } from '../../../../platform/progress/common/progress.js';
+
+export class WorkbenchDistributionService extends Disposable implements IDistributionService {
+    declare readonly _serviceBrand: undefined;
+
+    private readonly proxy: IDistributionService;
+
+    private _currentDistroPath: string | undefined;
+    private readonly _onDidChangeDistribution = this._register(new Emitter<void>());
+    readonly onDidChangeDistribution = this._onDidChangeDistribution.event;
+
+    private readonly _onInstallProgress = this._register(new Emitter<{ steps: number; total: number; message: string }>());
+    readonly onInstallProgress = this._onInstallProgress.event;
+
+    constructor(
+        @IRemoteAgentService remoteAgentService: IRemoteAgentService,
+        
+        @INotificationService private readonly notificationService: INotificationService,
+        @IProgressService private readonly progressService: IProgressService
+    ) {
+        super();
+
+        const channel = mainProcessService.getChannel(DISRIBUTION_IPC_CHANNEL_NAME);
+        this.proxy = ProxyChannel.toService<IDistributionService>(channel);
+
+        this._register(this.proxy.onDidChangeDistribution(() => {
+            this.refresh();
+        }));
+        this._register(this.proxy.onInstallProgress(e => this._onInstallProgress.fire(e)));
+
+        this.refresh().then(() => this.checkAndPrompt());
+    }
+
+    get currentDistroPath(): string | undefined {
+        return this._currentDistroPath;
+    }
+
+    async checkDistro(): Promise<string | undefined> {
+        const path = await this.proxy.checkDistro();
+        this.updatePath(path);
+        return path;
+    }
+
+    install(): Promise<void> {
+        return this.proxy.install();
+    }
+
+    uninstall(): Promise<void> {
+        return this.proxy.uninstall();
+    }
+
+    installPackage(packageName: string): Promise<void> {
+        return this.proxy.installPackage(packageName);
+    }
+
+    findPackageForFile(fileName: string): Promise<string | undefined> {
+        return this.proxy.findPackageForFile(fileName);
+    }
+
+    private async refresh(): Promise<void> {
+        const path = await this.proxy.checkDistro();
+        this.updatePath(path);
+    }
+
+    private updatePath(newPath: string | undefined): void {
+        if (this._currentDistroPath !== newPath) {
+            this._currentDistroPath = newPath;
+            this._onDidChangeDistribution.fire();
+        }
+    }
+
+    private async checkAndPrompt(): Promise<void> {
+        if (!this._currentDistroPath) {
+            this.notificationService.prompt(
+                Severity.Info,
+                'Underoot requires TeX Live to function properly. Would you like to install it now?',
+                [{
+                    label: 'Install TeX Live',
+                    run: () => this.runInstall()
+                }, {
+                    label: 'Later',
+                    run: () => { }
+                }]
+            );
+        }
+    }
+
+    private async runInstall(): Promise<void> {
+        await this.progressService.withProgress({
+            location: ProgressLocation.Notification,
+            title: 'Installing TeX Live...',
+            cancellable: false
+        }, async (progress) => {
+            progress.report({ message: 'Starting...' });
+
+            const listener = this.proxy.onInstallProgress(e => {
+                progress.report({
+                    message: e.message,
+                    increment: 0 // We don't have absolute here yet
+                });
+            });
+
+            try {
+                await this.install();
+                this.notificationService.info('TeX Live installed successfully.');
+            } catch (error) {
+                this.notificationService.error(`Installation failed: ${error}`);
+            } finally {
+                listener.dispose();
+            }
+        });
+    }
+}
+
+registerSingleton(IDistributionService, WorkbenchDistributionService, 1 /* InstantiationType.Delayed */);

+
+import { createDecorator } from '../../instantiation/common/instantiation.js';
+import { Event } from '../../../base/common/event.js';
+
+export const IDistributionService = createDecorator<IDistributionService>('distributionService');
+
+export interface IDistributionService {
+	readonly _serviceBrand: undefined;
+
+	/**
+	 * Emitted when the distribution state changes.
+	 */
+	readonly onDidChangeDistribution: Event<void>;
+
+	/**
+	 * Emitted when installation progress is updated.
+	 */
+	readonly onInstallProgress: Event<{ steps: number; total: number; message: string }>;
+
+	/**
+	 * Checks if a managed TeX distribution exists.
+	 * Returns the path to the bin directory if found.
+	 */
+	checkDistro(): Promise<string | undefined>;
+
+	/**
+	 * Installs the default TeX distribution.
+	 */
+	install(): Promise<void>;
+
+	/**
+	 * Installs a specific package using tlmgr.
+	 */
+	installPackage(packageName: string): Promise<void>;
+
+	/**
+	 * Finds the package that contains the specified file.
+	 */
+	findPackageForFile(fileName: string): Promise<string | undefined>;
+
+	/**
+	 * Uninstalls the managed distribution.
+	 */
+	uninstall(): Promise<void>;
+}
